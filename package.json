{
  "name": "StudyHub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:testhub": "turbo run dev --filter=testhub",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "postinstall": "npm run db:generate",
    "sync-s3": "npx tsx scripts/sync-s3.ts",
    "init:vector": "npx tsx scripts/init-vector.ts",
    "db:generate": "cd packages/db && npx prisma generate && cd ../..",
    "start-app": "cd ./apps/web && npm run start",
    "start:web": "cd ./apps/web && npm run start",
    "start:testhub": "cd ./apps/testhub && npm run start",
    "ingest:pyq": "npx tsx scripts/pyq-pipeline/index.ts",
    "parser:dev": "python -m uvicorn app.main:app --app-dir services/pdf-parser --port 8001 --reload"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/pdf-parse": "^1.1.5",
    "prettier": "^3.7.4",
    "turbo": "^2.9.18",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1104.0",
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "@tailwindcss/postcss": "^4.3.3",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "framer-motion": "^13.0.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.28.0",
    "next-auth": "^4.24.14",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "postcss": "^8.5.30",
    "react-icons": "^5.6.0",
    "react-pdf": "^10.4.1",
    "recoil": "^0.7.7",
    "resend": "^6.18.1",
    "tailwindcss": "^4.3.3"
  }
}
