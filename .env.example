# Environment variables for StudyHub

# Database (already existing)
DATABASE_URL="postgresql://user:password@localhost:5432/studybyd?schema=public"

# Kafka telemetry (add these)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=web_telemetry

# Optional: Secure Kafka connection (SASL_SSL)
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=your_username
# KAFKA_SASL_PASSWORD=your_password
# KAFKA_SSL_CA_LOCATION=path/to/ca.pem  # Relative to project root or absolute

# AWS (existing)
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
NEXT_PUBLIC_CDN_URL=https://your-cdn-domain.com/

# NextAuth (existing)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key

# OAuth (existing)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (existing)
RESEND_API_KEY=re_your_resend_api_key