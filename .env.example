# ==============================================================================
# StudyHub Monorepo Environment Variables (.env.example)
# Copy this file to .env or create specific .env files in individual apps/packages
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL with pgvector extension)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/studybyd?schema=public"
# Optional remote Neon URL for scripts/pyq-pipeline dual-sync:
NEON_DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/studyhub?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AWS Infrastructure (S3 Document Storage & Bedrock AI)
# ------------------------------------------------------------------------------
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="your-s3-bucket-name"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
NEXT_PUBLIC_CDN_URL="https://your-cdn-domain.com/"

# ------------------------------------------------------------------------------
# 3. NextAuth Authentication (StudyHub & TestHub)
# ------------------------------------------------------------------------------
# Web app runs on port 3000, TestHub runs on port 3001
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key"
# Optional domain for cross-subdomain SSO cookies:
COOKIE_DOMAIN=""

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin Access
ADMIN_EMAIL="yashgupta.yg318@gmail.com"

# ------------------------------------------------------------------------------
# 4. Email Service (Resend OTP Verification)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"

# ------------------------------------------------------------------------------
# 5. Apache Kafka Telemetry Pipeline
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TOPIC="web_telemetry"
# Optional: Secure SASL connection
# KAFKA_SASL_MECHANISM="SCRAM-SHA-256"
# KAFKA_SASL_USERNAME="your_username"
# KAFKA_SASL_PASSWORD="your_password"
# KAFKA_SSL_CA_LOCATION="path/to/ca.pem"

# ------------------------------------------------------------------------------
# 6. Advanced AI & Parser Engine Credentials
# ------------------------------------------------------------------------------
# Google Gemini API key (Used by services/pdf-parser for high-precision STEM parsing)
GEMINI_API_KEY="your-gemini-api-key"
# TypeSafe AI API Key (Used by apps/testhub for structured question extraction)
TYPESAFE_API_KEY="your-typesafe-api-key"
