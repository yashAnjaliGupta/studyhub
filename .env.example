# ==============================================================================
# StudyHub Monorepo Environment Variables (.env.example)
# Copy this file to .env or configure in your deployment platform (Vercel, AWS, etc.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL with pgvector extension)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/studyhub?schema=public"
# Optional direct unpooled URL for migrations if using PgBouncer/Neon pooler:
DIRECT_URL="postgresql://postgres:password@localhost:5432/studyhub?schema=public"
# Optional remote Neon URL for scripts/pyq-pipeline dual-sync:
NEON_DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/studyhub?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AWS Infrastructure (S3 Document Storage & Bedrock AI)
# ------------------------------------------------------------------------------
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="your-s3-bucket-name"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# Dedicated Bedrock credentials (optional, falls back to AWS_ACCESS_KEY_ID above)
AWS_BEDROCK_REGION="us-east-1"
AWS_BEDROCK_ACCESS_KEY_ID="your-bedrock-access-key-id"
AWS_BEDROCK_SECRET_ACCESS_KEY="your-bedrock-secret-access-key"

# CloudFront CDN URL for textbook PDFs & diagrams
NEXT_PUBLIC_CDN_URL="https://your-cdn-domain.com/"

# ------------------------------------------------------------------------------
# 3. NextAuth Authentication (StudyHub & TestHub)
# ------------------------------------------------------------------------------
# Web app runs on port 3000, TestHub runs on port 3001
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-32-byte-secret-using-openssl-rand-hex-32"
# Optional domain for cross-subdomain SSO cookies (e.g. .yourdomain.com):
COOKIE_DOMAIN=""

# Public Cross-App URLs
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_STUDYHUB_URL="https://yourdomain.com"
NEXT_PUBLIC_TESTHUB_URL="https://test.yourdomain.com"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin Access
ADMIN_EMAIL="admin@yourdomain.com"

# ------------------------------------------------------------------------------
# 4. Redis Distributed State & Hot Caching (Upstash Redis)
# ------------------------------------------------------------------------------
# Required for multi-pod / serverless distributed OTP verification & session caching
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ------------------------------------------------------------------------------
# 5. Email Service (Resend OTP Verification)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="StudyHub <auth@yourdomain.com>"

# ------------------------------------------------------------------------------
# 6. Apache Kafka Telemetry Pipeline
# ------------------------------------------------------------------------------
KAFKA_BROKERS="localhost:9092"
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TOPIC="studyhub-telemetry"
KAFKA_EXAM_TOPIC="exam-telemetry"
KAFKA_CLIENT_ID="studyhub-producer"

# Optional: Secure SASL / SSL connection for managed Kafka (Upstash Kafka / Confluent / AWS MSK)
# KAFKA_SSL="true"
# KAFKA_SASL_MECHANISM="SCRAM-SHA-256"
# KAFKA_SASL_USERNAME="your_username"
# KAFKA_SASL_PASSWORD="your_password"
# KAFKA_SSL_CA_LOCATION="path/to/ca.pem"

# ------------------------------------------------------------------------------
# 7. AI & STEM Microservices
# ------------------------------------------------------------------------------
# FastAPI PDF Parser microservice URL (defaults to http://localhost:8001)
PDF_PARSER_SERVICE_URL="http://localhost:8001"

# Google Gemini API key (Used by services/pdf-parser and fallback RAG synthesis)
GEMINI_API_KEY="your-gemini-api-key"

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY="your-openai-api-key"

# TypeSafe AI API Key (Used by apps/testhub for structured question extraction)
TYPESAFE_API_KEY="your-typesafe-api-key"
