{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "NODE_ENV",
    "ADMIN_EMAIL",
    "AWS_REGION",
    "AWS_BUCKET_NAME",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_BEDROCK_ACCESS_KEY_ID",
    "AWS_BEDROCK_SECRET_ACCESS_KEY",
    "AWS_BEDROCK_REGION",
    "NEXTAUTH_URL",
    "NEXTAUTH_SECRET",
    "COOKIE_DOMAIN",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "KAFKA_BROKERS",
    "KAFKA_BOOTSTRAP_SERVERS",
    "KAFKA_TOPIC",
    "KAFKA_EXAM_TOPIC",
    "KAFKA_SASL_MECHANISM",
    "KAFKA_SASL_USERNAME",
    "KAFKA_SASL_PASSWORD",
    "KAFKA_SSL",
    "KAFKA_SSL_CA",
    "KAFKA_SSL_CA_LOCATION",
    "KAFKA_SSL_REJECT_UNAUTHORIZED",
    "PDF_PARSER_SERVICE_URL",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "OPENAI_API_KEY",
    "GEMINI_API_KEY",
    "NEXT_PUBLIC_CDN_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_STUDYHUB_URL",
    "NEXT_PUBLIC_TESTHUB_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
